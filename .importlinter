# The client is independent of its hosts and of the sibling auth library:
# everything host-specific reaches it through the ports a host supplies. An app
# serves its tools through agent_runtime_client.mcp_server, whose library stays
# an extra, so no client base module (the package __init__ included) imports
# agent_runtime_client.mcp_server. The client imports no web framework: its MCP
# server is a thin ASGI shell before the official SDK, which needs one of its own.
# The gate's `import-contract` rule (`quality check`) checks them over the
# real import graph, so an indirect chain is caught as well as a direct import.
[importlinter]
include_external_packages = True
root_packages =
    agent_runtime_client

[importlinter:contract:client-reaches-back-into-no-host]
name = agent_runtime_client reaches back into no host
type = forbidden
source_modules =
    agent_runtime_client
forbidden_modules =
    songmaker_cli
    webauth

[importlinter:contract:client-imports-no-web-framework]
name = agent_runtime_client imports no web framework
type = forbidden
source_modules =
    agent_runtime_client
forbidden_modules =
    fastapi
    starlette
    uvicorn

# as_packages = False keeps agent_runtime_client itself (its __init__) a source without
# making the mcp_server package inside it one; the ** wildcard keeps every
# mcp_server module forbidden.
[importlinter:contract:client-base-stays-free-of-mcp-server]
name = the client base modules import neither agent_runtime_client.mcp_server nor its extras
type = forbidden
as_packages = False
source_modules =
    agent_runtime_client
    agent_runtime_client.agents
    agent_runtime_client.backend
    agent_runtime_client.backend.fake_gateway
    agent_runtime_client.backend.gateway
    agent_runtime_client.backend.streamed_round
    agent_runtime_client.config
    agent_runtime_client.errors
    agent_runtime_client.member
    agent_runtime_client.mcp_wire
    agent_runtime_client.tools
    agent_runtime_client.turn
    agent_runtime_client.turn_events
forbidden_modules =
    agent_runtime_client.mcp_server
    agent_runtime_client.mcp_server.**
    anyio
    mcp
    mcp_types

# The voice extra stays an extra the same way: the package __init__ is a source, the voice
# package inside it is not, and the ** wildcard keeps every voice module forbidden.
[importlinter:contract:client-base-stays-free-of-voice]
name = the client base modules import neither agent_runtime_client.voice nor its extra
type = forbidden
as_packages = False
source_modules =
    agent_runtime_client
    agent_runtime_client.agents
    agent_runtime_client.backend
    agent_runtime_client.backend.fake_gateway
    agent_runtime_client.backend.gateway
    agent_runtime_client.backend.streamed_round
    agent_runtime_client.config
    agent_runtime_client.errors
    agent_runtime_client.member
    agent_runtime_client.mcp_wire
    agent_runtime_client.tools
    agent_runtime_client.turn
    agent_runtime_client.turn_events
forbidden_modules =
    agent_runtime_client.voice
    agent_runtime_client.voice.**
    syntok

# The backend extra stays an extra: backend.gateway and backend.fake_gateway import
# httpx2, so no base module (the package __init__ and the backend port included) does.
[importlinter:contract:client-base-stays-free-of-http]
name = the client base modules import no HTTP library
type = forbidden
as_packages = False
source_modules =
    agent_runtime_client
    agent_runtime_client.agents
    agent_runtime_client.backend
    agent_runtime_client.config
    agent_runtime_client.errors
    agent_runtime_client.member
    agent_runtime_client.mcp_wire
    agent_runtime_client.tools
    agent_runtime_client.turn
    agent_runtime_client.turn_events
forbidden_modules =
    httpx2
    httpx
    mcp
    mcp_types

[importlinter:contract:hand-tools-stay-below-the-wire]
name = agent_runtime_client.tools does not import agent_runtime_client.mcp_wire
type = forbidden
source_modules =
    agent_runtime_client.tools
forbidden_modules =
    agent_runtime_client.mcp_wire

# The streamed-round reader is pure: it frames bytes and assembles a round, so it imports no HTTP
# library, and gateway.py calls it, never the reverse.
[importlinter:contract:streamed-round-stays-pure]
name = backend.streamed_round imports no HTTP library and not backend.gateway
type = forbidden
source_modules =
    agent_runtime_client.backend.streamed_round
forbidden_modules =
    httpx2
    httpx
    agent_runtime_client.backend.gateway

# Sound stays with the app and the speech service: the client sees only text.
[importlinter:contract:client-imports-no-speech-library]
name = agent_runtime_client imports no speech library
type = forbidden
source_modules =
    agent_runtime_client
forbidden_modules =
    speech_runtime_client

# The voice loop runs on the AgentBackend port alone, so it stays off the wire and runs its own
# tasks with the standard library's asyncio.TaskGroup.
[importlinter:contract:voice-stays-off-the-wire]
name = agent_runtime_client.voice imports no HTTP or MCP library, no backend implementation and no anyio
type = forbidden
source_modules =
    agent_runtime_client.voice
forbidden_modules =
    httpx2
    httpx
    mcp
    mcp_types
    anyio
    agent_runtime_client.backend.gateway
    agent_runtime_client.backend.fake_gateway
    agent_runtime_client.mcp_server

# syntok lives in voice.sentences; the other voice modules reach it only through that module.
[importlinter:contract:only-voice-sentences-imports-syntok]
name = only agent_runtime_client.voice.sentences imports syntok
type = forbidden
as_packages = False
allow_indirect_imports = True
source_modules =
    agent_runtime_client.voice
    agent_runtime_client.voice.conversation
    agent_runtime_client.voice.loop
    agent_runtime_client.voice.reply
    agent_runtime_client.voice.wake
forbidden_modules =
    syntok
